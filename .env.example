# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored. NEVER put a real key in this example file or commit ".env".

LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=none
OPENAI_API_KEY=paste-your-key-here

# Optional: folder the agent may read videos from. If you leave this out, the
# agent uses ./samples when it exists, otherwise it asks you at startup.
# (Use your own path; you can also switch with /folder <path> while chatting.)
# GHOST_VIDEOS_DIR=C:\path\to\your\videos

# Other providers (set the matching key instead):
#   LLM_PROVIDER=anthropic   ANTHROPIC_API_KEY=...   (default model built in)
#   LLM_PROVIDER=gemini      GEMINI_API_KEY=...       LLM_MODEL=<model name>
#   LLM_PROVIDER=grok        XAI_API_KEY=...          LLM_MODEL=<model name>
#   LLM_PROVIDER=custom      LLM_API_KEY=...          LLM_MODEL=...  LLM_BASE_URL=<endpoint>
